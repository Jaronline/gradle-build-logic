#!/usr/bin/env bash

echo "Running git pre-commit hook."
echo "Running Spotless Check..."

if ! ./gradlew spotlessCheck --quiet; then
  echo
  echo -e "\e[31mSpotless Check found violations.\e[0m"
  echo "Run spotlessApply in your terminal and fix the issues before trying to commit again."
  exit 1
fi

echo -e "\e[32mSpotless Check found no violations.\e[0m"

echo "Running README Check..."

if ! ./gradlew readmeCheck --quiet; then
  echo
  echo -e "\e[31mREADME Check found violations.\e[0m"
  echo "Run updateReadme in your terminal before trying to commit again."
  exit 1
fi

echo -e "\e[32mREADME Check found no violations.\e[0m"
exit 0